# Redis configuration template

# Network
bind 0.0.0.0
port 6385
protected-mode yes

# Security
requirepass ${REDIS_PASSWORD}
user ${REDIS_USER} on >${REDIS_PASSWORD} ~* +@all

# Persistence
dir /data
appendonly yes
appendfilename "appendonly.aof"

# Memory management
maxmemory 1gb
maxmemory-policy allkeys-lru

# Logging
loglevel notice
logfile ""

# Client settings
timeout 0
tcp-keepalive 300
