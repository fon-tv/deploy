# Settings
STACK_NAME=nodejs_django_stack

# Server Names
ADMIN_SERVER_NAME=admin.example.com
APP_SERVER_NAME=example.com

# Database Configuration
DB_HOST=db
DB_PORT=5432
APP_DB_NAME=app
DJANGO_DB_NAME=django

# Registry Configuration
REGISTRY_URL=registry.example.com:5000

# External Services
SPORTS_API_URL=http://localhost:8081

# S3 Configuration
AWS_S3_ENDPOINT_URL=http://localhost:9000
S3_ROOT_URL=http://localhost:9000/media

# Required Docker Secrets (create using docker secret create <name> -)
# AWS S3 credentials
# aws_s3_access_key_id
# aws_s3_secret_access_key

# Cache invalidation key for inter-service communication
# cache_invalidate_key

# Database credentials
# db_password             # Database root password
# db_app_user             # Application database user
# db_app_password         # Application database password
# db_django_user          # Django database user
# db_django_password      # Django database password

# Redis credentials
# redis_user              # Redis username
# redis_password          # Redis password

# Django configuration
# django_secret_key       # Django SECRET_KEY
# django_superuser_email  # Django admin email
# django_superuser_username  # Django admin username
# django_superuser_password  # Django admin password

# SSL certificates
# cert.crt                # SSL certificate
# cert.key                # SSL private key 
